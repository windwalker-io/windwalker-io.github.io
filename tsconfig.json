{
  "include": [
    ".vitepress/**/*.mts",
    ".vitepress/**/*.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.vue",
    "**/*.md",
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"],
  },
}
